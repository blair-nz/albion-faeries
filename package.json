{
  "name": "albionfaeries-org-uk",
  "private": true,
  "version": "1.0.0",
  "description": "Albion Faeries public hearth, event minisites, and Circles",
  "scripts": {
    "dev": "wrangler pages dev . --d1=CIRCLES_DB=albion-faeries-circles",
    "deploy": "wrangler pages deploy . --project-name=albion-faeries-site",
    "db:create": "wrangler d1 create albion-faeries-circles",
    "db:migrate:local": "wrangler d1 execute albion-faeries-circles --local --file=./migrations/0001_init.sql",
    "db:migrate": "wrangler d1 execute albion-faeries-circles --remote --file=./migrations/0001_init.sql",
    "encode:videos": "powershell -ExecutionPolicy Bypass -File ./scripts/encode-videos.ps1"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
